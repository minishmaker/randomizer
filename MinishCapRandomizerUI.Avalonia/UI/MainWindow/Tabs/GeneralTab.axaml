<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MinishCapRandomizerUI.Avalonia.UI.MainWindow.Tabs.GeneralTab">
  <ScrollViewer>
    <StackPanel Margin="12" HorizontalAlignment="Stretch" Spacing="12">
      <HeaderedContentControl Header="ROM &amp; Seed" Classes="compact-groupbox">
        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="0">
          <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="European Minish Cap ROM" Margin="0,0,12,0" />
          <TextBox Name="RomPath" Grid.Row="0" Grid.Column="1" Margin="0,0,12,0" />
          <Button Name="BrowseRom" Grid.Row="0" Grid.Column="2" Content="Browse" MinWidth="90" />
          <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Randomizer Seed" Margin="0,0,12,0" />
          <TextBox Name="Seed" Grid.Row="1" Grid.Column="1" Margin="0,0,12,0" />
          <Button Name="RandomSeed" Grid.Row="1" Grid.Column="2" Content="New Seed" MinWidth="90" />
        </Grid>
      </HeaderedContentControl>

      <HeaderedContentControl Header="Settings" Classes="compact-groupbox">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" HorizontalAlignment="Stretch">
          <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Settings String:" Margin="0,0,12,0" />
          <TextBox Name="SettingString" Grid.Row="0" Grid.Column="1" />
          <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Columns="3" HorizontalAlignment="Stretch" Margin="0,8,0,0">
            <Button Name="LoadSettings" Content="Load Settings" MinWidth="120" HorizontalAlignment="Stretch" />
            <Button Name="GenerateSettings" Content="Generate String" MinWidth="140" HorizontalAlignment="Stretch" />
            <Button Name="ResetDefaultSettings" Content="Reset Defaults" MinWidth="140" HorizontalAlignment="Stretch" />
          </UniformGrid>
          <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Settings Preset:" Margin="0,8,12,0" />
          <ComboBox Name="SettingPresets" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" HorizontalAlignment="Stretch" />
          <UniformGrid Grid.Row="3" Grid.ColumnSpan="2" Columns="3" HorizontalAlignment="Stretch" Margin="0,8,0,0">
            <Button Name="LoadSettingPreset" Content="Load Preset" MinWidth="120" HorizontalAlignment="Stretch" />
            <Button Name="SaveSettingPreset" Content="Save Current As Preset" MinWidth="190" HorizontalAlignment="Stretch" />
            <Button Name="DeleteSettingPreset" Content="Delete Preset" MinWidth="140" HorizontalAlignment="Stretch" />
          </UniformGrid>
        </Grid>
      </HeaderedContentControl>

      <HeaderedContentControl Header="Cosmetics" Classes="compact-groupbox">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" HorizontalAlignment="Stretch">
          <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Cosmetics String:" Margin="0,0,12,0" />
          <TextBox Name="CosmeticsString" Grid.Row="0" Grid.Column="1" />
          <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Columns="3" HorizontalAlignment="Stretch" Margin="0,8,0,0">
            <Button Name="LoadCosmetics" Content="Load Cosmetics" MinWidth="140" HorizontalAlignment="Stretch" />
            <Button Name="GenerateCosmetics" Content="Generate String" MinWidth="140" HorizontalAlignment="Stretch" />
            <Button Name="ResetDefaultCosmetics" Content="Reset Defaults" MinWidth="140" HorizontalAlignment="Stretch" />
          </UniformGrid>
          <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Cosmetics Preset:" Margin="0,8,12,0" />
          <ComboBox Name="CosmeticsPresets" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" HorizontalAlignment="Stretch" />
          <UniformGrid Grid.Row="3" Grid.ColumnSpan="2" Columns="3" HorizontalAlignment="Stretch" Margin="0,8,0,0">
            <Button Name="LoadCosmeticPreset" Content="Load Preset" MinWidth="120" HorizontalAlignment="Stretch" />
            <Button Name="SaveCosmeticPreset" Content="Save Current As Preset" MinWidth="190" HorizontalAlignment="Stretch" />
            <Button Name="DeleteCosmeticPreset" Content="Delete Preset" MinWidth="140" HorizontalAlignment="Stretch" />
          </UniformGrid>
        </Grid>
      </HeaderedContentControl>

      <HeaderedContentControl Header="BPS Patcher &amp; Patch Generator" Classes="compact-groupbox">
        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" HorizontalAlignment="Stretch">
          <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Patcher Mode:" Margin="0,0,12,0" />
          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center">
            <RadioButton Name="ApplyPatchButton" Content="Apply Patch" IsChecked="True" />
            <RadioButton Name="GeneratePatchButton" Content="Generate Patch" />
          </StackPanel>
          <CheckBox Grid.Row="0" Grid.Column="2" Name="UseCustomCosmetics" Content="Use Custom Cosmetics (Disabled)" IsEnabled="False" />
          <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Name="BpsPatchAndPatchedRomLabel" Text="BPS Patch File Path:" Margin="0,0,12,0" />
          <TextBox Grid.Row="1" Grid.Column="1" Name="BpsPatchAndPatchedRomPath" Margin="0,0,12,0" HorizontalAlignment="Stretch" />
          <Button Grid.Row="1" Grid.Column="2" Name="BrowsePatchOrRom" Content="Browse" MinWidth="90" />
          <Grid Grid.Row="2" Grid.ColumnSpan="3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Name="PatchRomAndGenPatch" Content="Patch Rom" MinWidth="160" HorizontalAlignment="Right" />
          </Grid>
        </Grid>
      </HeaderedContentControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
